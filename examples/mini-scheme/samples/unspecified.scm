; What an expression with no value answers. In Guile it is its own value,
; which prints as #<unspecified>: not '(), and true in a condition.
(display (if #f #f)) (newline)
(display (when #f 1)) (newline)
(display (unless #t 1)) (newline)
(display (cond (#f 1))) (newline)
(display (case 1 ((2) 3))) (newline)
(define x 1)
(display (set! x 2)) (newline)
(display (display "")) (newline)
(display (newline))
(newline)
(display (for-each display (list))) (newline)
(define (show) (display "shown"))
(display (show)) (newline)
; Inside a list, and at the end of an improper one.
(display (list 1 (if #f #f) 2)) (newline)
(display (cons 1 (if #f #f))) (newline)
(display (map (lambda (v) (if #f #f)) (list 1 2))) (newline)
; Not nil, not false, but true; and every one of them equals every other.
(display (null? (if #f #f))) (newline)
(display (pair? (if #f #f))) (newline)
(display (not (if #f #f))) (newline)
(display (boolean? (if #f #f))) (newline)
(display (if (if #f #f) 'true 'false)) (newline)
(display (eq? (if #f #f) '())) (newline)
(display (eqv? (if #f #f) (if #f #f))) (newline)
(display (equal? (if #f #f) (if #f #f))) (newline)
(display (equal? (list 1 (if #f #f)) (list 1 (if #f #f)))) (newline)
(display (member (if #f #f) (list 1 (if #f #f)))) (newline)
; The same value however it is reached: eq? as well as eqv? and equal?.
(display (eq? (if #f #f) (if #f #f))) (newline)
(define u (if #f #f))
(display (eq? u (display ""))) (newline)
(display (eq? u '())) (newline)
(display (eq? u #f)) (newline)
(display (list (if #f #f) 1)) (newline)
(display (list (list (if #f #f)))) (newline)
(display (assoc (if #f #f) (list (cons (if #f #f) 7)))) (newline)
