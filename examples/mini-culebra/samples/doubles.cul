# How a Float prints: the shortest digits that round trip, in culebra's
# layout. Fixed notation from 1e-4 up to (not including) 1e6 with a ".0" on
# a whole number, an exponent outside that with none ("1e+06", "1e-05").
# The same text from println, an interpolation and an array.
let big = 1e300 * 1e300
let nan = big - big
let values = [
  -0.0, 0.1, 100000.0, 999999.0, 1.0e6, 0.0001, 0.00001, 1.0e15,
  12345678901234567.0, 5.0e-324, big, -big, nan
]
for v in values { println(v) }
println([0.0001, 0.00001, 1.0e6])
println("{1.0e16} {0.00001} {100000.0} {-0.0}")
