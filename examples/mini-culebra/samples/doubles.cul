# How a Float prints: the shortest digits that round trip, in culebra's
# layout. Fixed notation from 1e-4 up to (not including) 1e6 with a ".0" on
# a whole number, an exponent outside that with none ("1e+06", "1e-05").
# The same text from println, an interpolation and an array.
let big = 1e300 * 1e300
let nan = big - big
let values = [
  0.0, -0.0, 0.1, 0.5, 1.0, 100000.0, 999999.0, 1.0e6, 1234567.0,
  123456789.0, 0.0001, 0.00001, 0.00012345, 1.0e-7, 1.5e-10,
  1.0e15, 1.0e16, 1.0e20, 12345678901234567.0, 0.1 + 0.2, 1.0 / 3.0,
  2.5e-5, 5.0e-324, 1.7976931348623157e308, 9007199254740992.0,
  big, -big, nan, -1.5
]
for v in values { println(v) }
println([0.0001, 0.00001, 0.00012345, 1.0e6, 1.5e-10])
println("{1.0e16} {0.00001} {100000.0} {-0.0}")
