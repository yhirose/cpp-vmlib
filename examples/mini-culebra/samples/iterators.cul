# The custom iterator protocol: `iter`/`has_next`/`next`. `for x in v`
# already covered an array and a generator; this is the third shape --
# any object whose class declares `iter()`, which is a genuine extension
# point rather than the front end hard-coding two library types. See
# README.md for the one piece of the protocol left out (`dispose`), and
# why.

class Range {
  new(lo, hi) {
    self.lo = lo
    self.hi = hi
  }
  iter() { return self }
  has_next() { return self.lo < self.hi }
  next() {
    let v = self.lo
    self.lo = self.lo + 1
    return v
  }
}

for x in Range.new(0, 5) {
  println(x)
}

mut sum = 0
for x in Range.new(1, 11) {
  sum = sum + x
}
println("sum: {sum}")

# `iter()` need not return `self` -- any object answering `has_next`/
# `next` works, which is what makes this a real protocol rather than a
# special case for one shape.
class Countdown {
  new(from) { self.remaining = from }
  has_next() { return self.remaining > 0 }
  next() {
    let v = self.remaining
    self.remaining = self.remaining - 1
    return v
  }
}
class CountdownView {
  new(from) { self.from = from }
  iter() { return Countdown.new(self.from) }
}

mut seen = []
for x in CountdownView.new(3) {
  seen.push(x)
}
println("countdown: {seen}")

# A class with `iter`/`has_next`/`next` composes with the rest of the
# language -- nested loops, and an early break.
class Pair {
  new(a, b) { self.a = a; self.b = b }
  iter() { return self }
  has_next() { return self.a <= self.b }
  next() {
    let v = self.a
    self.a = self.a + 1
    return v
  }
}

mut pairs = []
for a in Pair.new(1, 3) {
  for b in Pair.new(1, 3) {
    if a == b { continue }
    pairs.push([a, b])
  }
}
println("pairs: {pairs}")

for x in Range.new(0, 100) {
  println("first: {x}")
  break
}
println("done")

# An object that is not iterable still raises a TypeError, unchanged --
# the message's exact wording is not, which examples/mini-culebra's own
# README already lists among what a trap does not share with culebra's.
try {
  for x in 5 { println(x) }
} catch e {
  println("caught: {e.kind}")
}
