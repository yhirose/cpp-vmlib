# What a call may be given and what an index may be: the container and call
# errors culebra raises as values with a `kind`. Every line is one the
# culebra 0.8.0 test suite pins (tests/test_array_ops.cul,
# test_runtime_errors.cul, test_positional_overflow.cul, test_class_call.cul),
# so each runs unmodified under `culebra`.

fn kind_of(f) { try { f(); 'no error' } catch e { e.kind } }

# A read counts a negative index from the end; a write, and the read half of
# a compound assignment, do not.
println([1, 2, 3][-1])
println([1, 2, 3][-3])
println('read -4: ' + kind_of(|| [1, 2, 3][-4]))
println('read 3: ' + kind_of(|| [1, 2, 3][3]))
mut xs = [1, 2, 3]
println('write -1: ' + kind_of(fn () { xs[-1] = 0 }))
println('write 3: ' + kind_of(fn () { xs[3] = 0 }))
let mixed = [1, 'x']
println('compound -1: ' + kind_of(fn () { mixed[-1] += 1 }))

# A lambda, a `fn` expression, a method and a constructor take a surplus
# argument silently and name a missing one; a `fn name(...)` declaration
# dispatches, so either miscount finds no method; a built-in method counts
# its arguments without the receiver.
fn said(f) { try { f(); 'no error' } catch e { "{e.kind}: {e.message}" } }

let lam = fn (a, b) { a }
println(said(|| lam(1)))
println(lam(1, 2, 3))

class C {
  new(a) {
    self.a = a
  }
}
println(said(|| C()))

fn wide(a) { a }
println(said(|| wide(1, 2)))
fn joined(a, b) { a }
println(said(|| joined(1)))

println(said(|| [1].size(9)))
println(said(|| [1].push()))
println(said(|| [1].push(1, 2, 3)))

# A class named in a call is constructed: `Point(3, 4)` is `Point.new(3, 4)`.
# A class is not a function to a higher-order built-in, and an object with a
# `new` field is not a class.
class Point {
  new(x, y) {
    self.x = x
    self.y = y
  }
  norm2() {
    self.x * self.x + self.y * self.y
  }
}
println(Point(3, 4).norm2())
println('map(Point): ' + kind_of(|| [1, 2, 3].map(Point)))
let fake = {new: fn (x) { x + 1 }}
println('fake(5): ' + kind_of(|| fake(5)))
println(fake.new(5))
