class Table {
  new() {
    self.a = 0
    self.b = 0
  }
}

fn run(n) {
  mut xs = []
  mut k = 0
  while k < 1000 {
    xs.push(0)
    k = k + 1
  }
  let d = Table.new()
  mut i = 0
  while i < n {
    xs[i % 1000] = i
    d['a'] = i
    d['b'] = i * 2
    i = i + 1
  }
  xs[7] + xs[999] + d['a'] + d['b']
}

println(run(200000))
